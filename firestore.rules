rules_version = '2';

// Firestore security rules — my-portfolio
//
// สถานะจริงของโปรเจกต์นี้ (ตรวจเมื่อ 2026-10-09):
// **ไม่มีโค้ดฝั่ง client อ่านหรือเขียน Firestore เลยแม้แต่ที่เดียว**
// (`getFirebaseDb()` ใน src/lib/firebase.ts ไม่ถูกเรียกจากที่ไหน)
// ทุกการเข้าถึงข้อมูลไปผ่าน Admin SDK ใน route handler ฝั่ง server เท่านั้น
//
// ข้อสำคัญที่ต้องเข้าใจ: **Admin SDK ไม่ถูกตรวจด้วยกฎในไฟล์นี้**
// มันใช้สิทธิ์ service account จึงผ่านทุกอย่างอยู่แล้ว ไฟล์นี้จึงทำหน้าที่เดียว
// คือปิดประตูฝั่ง client ให้สนิท — ไม่ใช่ควบคุม logic ของแอป
//
// ผลคือกฎที่ถูกต้องสำหรับทุก collection ที่มีอยู่ตอนนี้คือ "ปฏิเสธทั้งหมด"
// และเขียนไว้แบบเจาะจงต่อ collection เพื่อประกาศเจตนาให้ชัด ไม่ใช่ปล่อยให้
// catch-all จับเงียบๆ (ถ้าวันหนึ่งมีคนเผลอเพิ่มการอ่านฝั่ง client เข้ามา
// จะเห็นว่าต้องมาแก้ที่นี่อย่างจงใจก่อน)
//
// ทดสอบกฎ: firebase emulators:start --only firestore  (ต้องมี Java)
// deploy:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helper ----------
    //
    // ยังไม่มี match block ไหนใช้ helper เหล่านี้ เพราะทุกอย่างปิดหมด
    // เก็บไว้เป็นรูปแบบพร้อมใช้ตอนที่มี collection ที่ client ต้องอ่านจริง
    // (เช่นถ้าวันหนึ่งย้ายรายการสินค้าเข้ามาเป็น catalog สาธารณะ)
    //
    // หมายเหตุ: warning "Invalid variable name: request" / "Unused function"
    // ตอน compile เป็น warning ของ linter ไม่ใช่ error — `request` ใช้ได้จริงตอน runtime

    function isSignedIn() {
      return request.auth != null;
    }

    // role ต้องมาจาก custom claims เท่านั้น ให้ตรงกับที่ src/lib/session.ts อ่าน
    // ห้ามอ่าน role จาก document เพราะถ้าเผลอเปิดสิทธิ์เขียน ผู้ใช้ยกระดับตัวเองได้
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'ADMIN';
    }

    // ---------- คำสั่งซื้อและสิทธิ์ดาวน์โหลด ----------
    //
    // src/lib/checkout-orders.ts : checkoutOrders/{reference}
    //                              checkoutOrders/{reference}/downloads/{token}
    //
    // ปิดฝั่ง client ทั้งอ่านและเขียน แม้เป็นเจ้าของออเดอร์เองก็ตาม เพราะ:
    //   - สิทธิ์ดาวน์โหลดขึ้นอยู่กับโควตา (downloadCount/downloadLimit) และ
    //     วันหมดอายุ ซึ่งต้องหักแบบ atomic ใน transaction — rules ทำแทนไม่ได้
    //   - เอกสารเก็บ accessToken ของออเดอร์ ถ้าอ่านได้จะเท่ากับแจกสิทธิ์ดาวน์โหลด
    //   - สถานะ PAID ต้องมาจาก webhook ที่ verify ลายเซ็น Stripe แล้วเท่านั้น
    //     (src/app/api/webhooks/route.ts) ห้าม client เขียนเองเด็ดขาด
    //
    // ลูกค้าดูสถานะผ่าน GET /api/checkout/status และโหลดไฟล์ผ่าน GET /api/downloads
    // ซึ่งตรวจสิทธิ์ฝั่ง server ก่อนทุกครั้ง
    match /checkoutOrders/{reference} {
      allow read, write: if false;

      match /downloads/{token} {
        allow read, write: if false;
      }
    }

    // ---------- บันทึก webhook ของ Stripe ----------
    //
    // src/lib/checkout-orders.ts : stripeWebhookEvents/{eventId}
    // ใช้กันการประมวลผล event ซ้ำ (idempotency) ไม่ใช่ข้อมูลที่ client ต้องเห็น
    match /stripeWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // ---------- Fail-Closed default ----------
    //
    // ทุก path ที่ไม่มีกฎข้างบนครอบ = เข้าถึงไม่ได้
    // เตือนไว้: เงื่อนไขจากหลาย match block ถูก OR กัน ดังนั้นบล็อกนี้
    // "ไม่ได้" ล็อกทับ match อื่น — ถ้า match ไหน allow ไว้ อันนั้นจะผ่าน
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
