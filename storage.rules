rules_version = '2';

// Cloud Storage security rules — my-portfolio
//
// สถานะจริง (ตรวจเมื่อ 2026-10-09):
// ไม่มีโค้ดฝั่ง client อ่านหรือเขียน Storage เลย (`getFirebaseStorage()`
// ใน src/lib/firebase.ts ไม่ถูกเรียกจากที่ไหน) ทุกอย่างผ่าน Admin SDK ฝั่ง server
//
// เช่นเดียวกับ firestore.rules: **Admin SDK ไม่ถูกตรวจด้วยกฎในไฟล์นี้**
// ไฟล์นี้มีหน้าที่เดียวคือปิดประตูฝั่ง client
//
// deploy: firebase deploy --only storage
// (ต้องเปิดใช้ Storage ใน Firebase console ก่อน ไม่งั้น CLI จะตอบว่า
//  "Firebase Storage has not been set up on project")

service firebase.storage {
  match /b/{bucket}/o {

    // ---------- helper ----------
    // เก็บไว้เป็นรูปแบบพร้อมใช้ตอนที่มี path ที่ client ต้องเข้าถึงจริง

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'ADMIN';
    }

    // จำกัดชนิดและขนาดไฟล์ กันคนยัดไฟล์อะไรก็ได้เข้ามา
    function isImageUnder5MB() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    // ---------- ไฟล์สินค้าที่ลูกค้าจ่ายเงินแล้วดาวน์โหลด ----------
    //
    // path จริงมาจาก productObjectPath() ใน src/lib/firebase-admin.ts
    // = `${PRODUCT_STORAGE_PREFIX ?? 'products'}/${fileKey}`
    //
    // ปิดสนิททั้งอ่านและเขียนจากฝั่ง client แม้ล็อกอินแล้วก็ตาม เพราะสิทธิ์
    // ดาวน์โหลดขึ้นกับออเดอร์ + license + โควตา + วันหมดอายุ ซึ่ง rules ตรวจไม่ได้
    //
    // ลูกค้าได้ไฟล์ผ่าน GET /api/downloads ที่ server ตรวจสิทธิ์ หักโควตา
    // แล้ว proxy ไฟล์ให้ — ไม่มีการแจก public URL หรือ signed URL อายุยาว
    match /products/{fileName} {
      allow read, write: if false;
    }

    // ---------- สื่อสาธารณะ (ยังไม่เปิดใช้) ----------
    //
    // ตอนนี้รูปภาพทั้งหมดอยู่ใน public/images/ ของ repo ไม่ได้อยู่บน Storage
    // ถ้าวันหนึ่งหน้า /admin/media อัปโหลดขึ้น Storage จริง ให้เปิดบล็อกนี้
    //
    // match /public/media/{fileName} {
    //   allow read: if true;
    //   allow write: if isAdmin() && isImageUnder5MB();
    // }

    // ---------- Fail-Closed default ----------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
