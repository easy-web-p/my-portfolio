# Site Configuration
NEXT_PUBLIC_SITE_URL=https://phisitcode.web.app

# Stripe
# Publishable keys are intentionally exposed to the browser. Keep secret and
# webhook keys server-only, and use matching test or live keys together.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Private product delivery (server-only). Upload each paid ZIP as
# gs://$FIREBASE_STORAGE_BUCKET/products/<fileKey> and keep client Storage rules closed.
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
PRODUCT_STORAGE_PREFIX=products

# Contact Email Delivery (Resend or Nodemailer)
RESEND_API_KEY=re_your_api_key_here
CONTACT_RECEIVER_EMAIL=your-email@domain.com

# Firebase (client SDK)
# ค่าเหล่านี้ถูกส่งไปฝั่ง browser โดยการออกแบบของ Firebase — ไม่ใช่ความลับ
# การป้องกันที่แท้จริงอยู่ที่ Firestore/Storage security rules + การจำกัด API key ใน Google Cloud Console
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# optional — ไม่ใส่ก็ได้ แต่ Analytics จะไม่ทำงาน
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ตั้งเป็น true เพื่อให้ client ต่อกับ Firebase Local Emulator Suite แทน project จริง
# พอร์ตประกาศไว้ใน firebase.json — รันด้วย: firebase emulators:start
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false

# Firebase Admin SDK (server-only — ห้ามขึ้นต้นด้วย NEXT_PUBLIC_)
# ชี้ไปที่ไฟล์ service account key ที่เก็บไว้ "นอก" โฟลเดอร์โปรเจกต์
# บน Firebase App Hosting ไม่ต้องตั้งค่านี้ เพราะมี Application Default Credentials ให้อยู่แล้ว
GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\repo\service-account.json
